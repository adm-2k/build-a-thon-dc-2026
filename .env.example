# APPARATUS — environment contract (SPEC §7, validated at boot by lib/env.ts)
# Copy to .env.local per worktree. NEVER commit .env.local. Keys are delivered
# by the orchestrator out-of-band (see docs/ORCHESTRATION.md §1) — never pasted
# into HANDOFF.md, chat, or commit messages.
#
# FIXTURE-FIRST RULE: Lanes B (Tracer UI), C (Map UI), and E (Design/Hub) run
# with every DEP_*_MODE=fixture and NO keys at all. Only Lane A (engine) and
# Lane D (data) ever need live credentials.

# --- LLM primary: Google AI Studio (Gemini) --------------------------------
GOOGLE_GENERATIVE_AI_API_KEY=
# SPEC's gemini-2.5-flash is closed to new users (verified 2026-08-28);
# llm.ts reads the model id from here — ruling in ORCHESTRATION §8 T10.
GEMINI_MODEL=gemini-3.6-flash

# --- Database: Supabase (server-only; service-role key never reaches client) -
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM secondary: Hugging Face Inference Providers router -----------------
HF_TOKEN=

# --- Web search (one provider, wrapped once — DATA-CAVEATS §1 + addendum) ----
# Primary: Tavily (tvly-… key). Fallback: Brave (card required).
SEARCH_API_KEY=
SEARCH_PROVIDER=tavily
# BRAVE_SEARCH_API_KEY=

# --- Formalizer model pin (DATA-CAVEATS addendum §4 — swap via env, not code) -
HF_FORMALIZER_MODEL=Qwen/Qwen3-4B-Instruct-2507:nscale

# --- OCR vision model pin (SPEC v2 §7 / DATA-CAVEATS addendum 2 §10) ---------
# Swappable per-request (Scriptorium's model picker overrides this string);
# this is only the default. Registry of alternates lives in the addendum.
HF_OCR_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct

# --- Dependency ladder modes: live | cached | fixture ------------------------
# Resolution rule (ORCHESTRATION §8 T5, implemented in lib/env.ts): an explicit
# value always wins; an UNSET mode resolves to live when its key is present and
# to fixture when it is absent. Keys are only required by modes that need them.
DEP_SEARCH_MODE=fixture
DEP_FETCH_MODE=fixture
DEP_GEMINI_MODE=fixture
DEP_NGRAM_MODE=cached
DEP_WIKTIONARY_MODE=cached
DEP_HF_MODE=fixture
# SPEC v2 rungs (DATA-CAVEATS addendum 2 §§10-11): ocr gates on HF_TOKEN
# (primary is the HF router vision call); ner gates on
# GOOGLE_GENERATIVE_AI_API_KEY (primary is Gemini structured output).
DEP_OCR_MODE=fixture
DEP_NER_MODE=fixture

# Production (Vercel) sets every mode explicitly: SEARCH=live FETCH=live
# GEMINI=live HF=live NGRAM=cached WIKTIONARY=cached OCR=live NER=live.
# Flipping one var in Vercel puts a flaky dependency into demo-safe mode with
# no code change (each flip requires a redeploy — DATA-CAVEATS addendum §8).
