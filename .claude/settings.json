{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git push*)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git revert *)",
      "Bash(git worktree *)",
      "Bash(git rev-parse*)",
      "Bash(git merge *)",
      "Bash(git stash*)",
      "Bash(git check-ignore*)",
      "Bash(pnpm *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(bash scripts/*)",
      "Bash(gh pr *)",
      "Bash(gh api *)",
      "Bash(gh run *)",
      "Bash(gh repo view*)",
      "Bash(curl *)",
      "Bash(mkdir *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(ls*)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(wc *)",
      "Bash(python3 -c *)",
      "Bash(kill *)",
      "Bash(lsof *)",
      "WebFetch(domain:ai.google.dev)",
      "WebFetch(domain:supabase.com)",
      "WebFetch(domain:vercel.com)",
      "WebFetch(domain:docs.tavily.com)",
      "WebFetch(domain:huggingface.co)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(gh repo delete*)",
      "Read(.env.local)",
      "Read(.env.vercel)"
    ]
  }
}
